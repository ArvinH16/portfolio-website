# Environment variables for the contact form (Amazon SES) and the theme cookie.
#
# Local development: copy this file to `.env` and fill in your values.
# Production: add these in the Vercel dashboard (Settings → Environment Variables).

# The email address contact-form messages are sent to
EMAIL=you@website.com

# The verified Amazon SES sender address messages are sent from
FROM_EMAIL=portfolio-site@website.com

# AWS credentials for Amazon SES
AWS_ACCESS_KEY_ID=PASTE_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_SECRET_KEY

# Random string used to sign the theme-preference cookie
SESSION_SECRET=KEEP_IT_SECRET_KEEP_IT_SAFE
