# Environment variables for the contact form (Resend) and the theme cookie.
#
# Local development: copy this file to `.env` (or use `vercel dev` to pull from Vercel).
# Production: add these in the Vercel dashboard (Settings → Environment Variables).

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered. Until you verify a domain in Resend,
# this MUST be the email address you signed up to Resend with.
EMAIL=you@example.com

# The "from" address. Leave as Resend's shared sender until you verify your own domain.
FROM_EMAIL=onboarding@resend.dev

# Random string used to sign the theme-preference cookie
SESSION_SECRET=replace-with-a-long-random-string
